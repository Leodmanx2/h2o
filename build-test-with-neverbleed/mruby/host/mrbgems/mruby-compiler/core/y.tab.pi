    tree = tree->cdr;
  }
}
static void
dump_args(mrb_state *mrb, node *n, int offset)
{
  if (n->car) {
    dump_prefix(n, offset+1);
    printf("mandatory args:\n");
    dump_recur(mrb, n->car, offset+2);
  }
  n = n->cdr;
  if (n->car) {
    dump_prefix(n, offset+1);
    printf("optional args:\n");
    {
      node *n2 = n->car;
      while (n2) {
        dump_prefix(n2, offset+2);
        printf("%s=\n", mrb_sym_name(mrb, ((mrb_sym)(intptr_t)(n2->car->car))));
        mrb_parser_dump(mrb, n2->car->cdr, offset+3);
        n2 = n2->cdr;
      }
    }
  }
  n = n->cdr;
  if (n->car) {
    mrb_sym rest = ((mrb_sym)(intptr_t)(n->car));
    dump_prefix(n, offset+1);
    if (rest == <@! "*" !@>)
      printf("rest=*\n");
    else
      printf("rest=*%s\n", mrb_sym_name(mrb, rest));
  }
  n = n->cdr;
  if (n->car) {
    dump_prefix(n, offset+1);
    printf("post mandatory args:\n");
    dump_recur(mrb, n->car, offset+2);
  }
  n = n->cdr;
  if (n) {
    ((void)0);
    mrb_parser_dump(mrb, n, offset);
  }
}
static const char*
str_dump(mrb_state *mrb, const char *str, int len)
{
  int ai = mrb_gc_arena_save(mrb);
  mrb_value s;
  s = mrb_str_new(mrb, str, (mrb_int)len);
  s = mrb_str_dump(mrb, s);
  mrb_gc_arena_restore(mrb, ai);
  return ((((((struct RString*)(mrb_val_union(s).p)))->flags & 8)) ? (((struct RStringEmbed*)(((struct RString*)(mrb_val_union(s).p))))->ary) : (((struct RString*)(mrb_val_union(s).p)))->as.heap.ptr);
}
void
mrb_parser_dump(mrb_state *mrb, node *tree, int offset)
{
  int nodetype;
  if (!tree) return;
  again:
