}
static mrb_bool
skips(parser_state *p, const char *s)
{
  int c;
  for (;;) {
    for (;;) {
      c = nextc(p);
      if (c < 0) return 0;
      if (c == '\n') {
        p->lineno++;
        p->column = 0;
      }
      if (c == *s) break;
    }
    s++;
    if (peeks(p, s)) {
      size_t len = strlen(s);
      while (len--) {
        if (nextc(p) == '\n') {
