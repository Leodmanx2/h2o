static void
local_add_blk(parser_state *p, mrb_sym blk)
{
  local_add_f(p, blk ? blk : 0);
}
static void
local_add_kw(parser_state *p, mrb_sym kwd)
{
  local_add_f(p, kwd ? kwd : <@! "**" !@>);
}
static node*
locals_node(parser_state *p)
{
  return p->locals ? p->locals->car : ((void *)0);
}
static void
nvars_nest(parser_state *p)
{
  p->nvars = cons_gen(p,(((node*)(intptr_t)(0))),(p->nvars));
}
static void
nvars_block(parser_state *p)
{
  p->nvars = cons_gen(p,(((node*)(intptr_t)(-2))),(p->nvars));
}
static void
nvars_unnest(parser_state *p)
{
  p->nvars = p->nvars->cdr;
