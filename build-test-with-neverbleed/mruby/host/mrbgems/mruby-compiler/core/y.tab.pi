        nspaces = append_gen(p,(nspaces),list1_gen(p, (((node*)(intptr_t)(spaces)))));
        heredoc_push_indented(p, hinfo, nd->cdr, escaped, nspaces, empty && line_head);
      }
      return tHD_STRING_MID;
    }
    if (unindent && empty) {
      if (c == '\t')
