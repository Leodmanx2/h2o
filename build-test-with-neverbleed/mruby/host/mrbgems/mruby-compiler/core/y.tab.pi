      c = nextc(p);
      if (type & 0x02) {
        if (c == end || c == beg) {
          tokadd(p, c);
        }
        else if (c == '\n') {
          p->lineno++;
          p->column = 0;
          if (unindent) {
            nspaces = append_gen(p,(nspaces),list1_gen(p, (((node*)(intptr_t)(spaces)))));
            escaped = append_gen(p,(escaped),list1_gen(p, (((node*)(intptr_t)(pos)))));
            pos--;
