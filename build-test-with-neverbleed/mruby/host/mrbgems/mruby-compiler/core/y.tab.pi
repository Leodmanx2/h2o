}
static int32_t
read_escape(parser_state *p)
{
  int32_t c;
  switch (c = nextc(p)) {
  case '\\':
    return c;
  case 'n':
    return '\n';
  case 't':
    return '\t';
  case 'r':
    return '\r';
  case 'f':
    return '\f';
  case 'v':
    return '\13';
  case 'a':
    return '\007';
  case 'e':
    return 033;
  case '0': case '1': case '2': case '3':
  case '4': case '5': case '6': case '7':
  {
    int buf[3];
    int i;
    buf[0] = c;
    for (i=1; i<3; i++) {
      buf[i] = nextc(p);
      if (buf[i] < 0) goto eof;
      if (buf[i] < '0' || '7' < buf[i]) {
        pushback(p, buf[i]);
        break;
      }
    }
    c = scan_oct(buf, i, &i);
  }
  return c;
  case 'x':
  {
    int buf[2];
    int i;
    for (i=0; i<2; i++) {
      buf[i] = nextc(p);
      if (buf[i] < 0) goto eof;
      if (!((((unsigned)(buf[i]) - '0') < 10) || ((unsigned)(buf[i]) | 0x20) - 'a' < 6)) {
        pushback(p, buf[i]);
        break;
      }
    }
    if (i == 0) {
      yyerror(p, "invalid hex escape");
      return -1;
    }
    return scan_hex(p, buf, i, &i);
  }
  case 'u':
