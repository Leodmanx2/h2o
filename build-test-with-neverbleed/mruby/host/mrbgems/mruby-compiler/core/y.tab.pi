static node*
setup_numparams(parser_state *p, node *a)
{
  int nvars = ((int)(intptr_t)(p->nvars->car));
  if (nvars > 0) {
    int i;
    mrb_sym sym;
    if (a && (a->car || (a->cdr && a->cdr->car) || (a->cdr->cdr && a->cdr->cdr->car) || (a->cdr->cdr->cdr->cdr && a->cdr->cdr->cdr->cdr->car))) {
      yyerror(p, "ordinary parameter is defined");
    }
    else if (p->locals) {
      node* args = 0;
      for (i = nvars; i > 0; i--) {
        char buf[3];
        buf[0] = '_';
        buf[1] = i+'0';
        buf[2] = '\0';
        sym = intern_cstr_gen(p,(buf));
        args = cons_gen(p,(new_arg(p, sym)),(args));
        p->locals->car = cons_gen(p,(((node*)(intptr_t)(sym))),(p->locals->car));
      }
      a = new_args(p, args, 0, 0, 0, 0);
    }
  }
  return a;
}
