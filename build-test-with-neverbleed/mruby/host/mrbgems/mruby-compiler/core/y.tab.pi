static void
dump_int(uint16_t i, char *s)
{
  char *p = s;
  char *t = s;
  while (i > 0) {
    *p++ = (i % 10)+'0';
    i /= 10;
  }
  if (p == s) *p++ = '0';
  *p = 0;
  p--;
  while (t < p) {
    char c = *t;
    *t++ = *p;
    *p-- = c;
  }
}
