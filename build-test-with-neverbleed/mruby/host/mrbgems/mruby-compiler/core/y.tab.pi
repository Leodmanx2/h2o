  }
  else {
    c = (node*)parser_palloc(p, sizeof(mrb_ast_node));
  }
  c->car = car;
  c->cdr = cdr;
  c->lineno = p->lineno;
  c->filename_index = p->current_filename_index;
  if (p->lineno == 0 && p->current_filename_index > 0) {
