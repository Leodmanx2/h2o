static node*
new_int(parser_state *p, const char *s, int base, int suffix)
{
  node* result = list3_gen(p, ((node*)NODE_INT),((node*)parser_strdup(p, s)),(((node*)(intptr_t)(base))));
  if (suffix & (1<<0)) {
    result = new_rational(p, result);
  }
  if (suffix & (1<<1)) {
    result = new_imaginary(p, result);
  }
  return result;
}
