static void
local_nest(parser_state *p)
{
  p->locals = cons_gen(p,(0),(p->locals));
}
static void
local_unnest(parser_state *p)
{
  if (p->locals) {
    p->locals = p->locals->cdr;
  }
}
static mrb_bool
local_var_p(parser_state *p, mrb_sym sym)
{
  const struct RProc *u;
  node *l = p->locals;
  while (l) {
    node *n = l->car;
    while (n) {
      if (((mrb_sym)(intptr_t)(n->car)) == sym) return 1;
      n = n->cdr;
    }
    l = l->cdr;
  }
  u = p->upper;
  while (u && !(((u)->flags & 128) != 0)) {
    const struct mrb_irep *ir = u->body.irep;
    const mrb_sym *v = ir->lv;
    int i;
    if (v) {
      for (i=0; i+1 < ir->nlocals; i++) {
        if (v[i] == sym) return 1;
      }
    }
    if ((((u)->flags & 2048) != 0)) break;
    u = u->upper;
  }
  return 0;
}
static void
local_add_f(parser_state *p, mrb_sym sym)
{
  if (p->locals) {
    node *n = p->locals->car;
    while (n) {
      if (((mrb_sym)(intptr_t)(n->car)) == sym) {
        mrb_int len;
        const char* name = mrb_sym_name_len(p->mrb, sym, &len);
        if (len > 0 && name[0] != '_') {
          yyerror(p, "duplicated argument name");
          return;
        }
      }
      n = n->cdr;
    }
    p->locals->car = append_gen(p,(p->locals->car),list1_gen(p, (((node*)(intptr_t)(sym)))));
  }
}
static void
local_add(parser_state *p, mrb_sym sym)
