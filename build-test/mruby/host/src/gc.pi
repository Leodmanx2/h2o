    incremental_gc_until(mrb, gc, MRB_GC_STATE_ROOT);
  }
  gc->generational = 0;
  prepare_incremental_sweep(mrb, gc);
  incremental_gc_until(mrb, gc, MRB_GC_STATE_ROOT);
