  while (page != ((void *)0)) {
    RVALUE *p;
    int i;
    p = ((RVALUE *)page->objects);
    for (i=0; i < 1024; i++) {
      if ((*callback)(mrb, &p[i].as.basic, data) == 1)
        return;
    }
    page = page->next;
  }
}
void
mrb_objspace_each_objects(mrb_state *mrb, mrb_each_object_callback *callback, void *data)
{
