extern void
mrb_incremental_gc(mrb_state *mrb)
{
  mrb_gc *gc = &mrb->gc;
  if (gc->disabled || gc->iterating) return;
  ;
  ;
  if ((((gc)->generational) && !(gc)->full)) {
    incremental_gc_until(mrb, gc, MRB_GC_STATE_ROOT);
  }
  else {
    incremental_gc_step(mrb, gc);
  }
  if (gc->state == MRB_GC_STATE_ROOT) {
    ((void)0);
    gc->threshold = (gc->live_after_mark/100) * gc->interval_ratio;
    if (gc->threshold < 1024) {
      gc->threshold = 1024;
    }
    if ((((gc)->generational) && (gc)->full)) {
      size_t threshold = gc->live_after_mark/100 * 120;
      gc->full = 0;
      if (threshold < 10000) {
        gc->majorgc_old_threshold = threshold;
      }
      else {
        mrb_full_gc(mrb);
      }
    }
    else if ((((gc)->generational) && !(gc)->full)) {
      if (gc->live > gc->majorgc_old_threshold) {
        clear_all_old(mrb, gc);
        gc->full = 1;
      }
    }
  }
  ;
}
extern void
mrb_full_gc(mrb_state *mrb)
{
  mrb_gc *gc = &mrb->gc;
  if (!mrb->c) return;
  if (gc->disabled || gc->iterating) return;
  ;
  ;
  if (((gc)->generational)) {
    clear_all_old(mrb, gc);
    gc->full = 1;
  }
  else if (gc->state != MRB_GC_STATE_ROOT) {
    incremental_gc_until(mrb, gc, MRB_GC_STATE_ROOT);
  }
  incremental_gc_until(mrb, gc, MRB_GC_STATE_ROOT);
  gc->threshold = (gc->live_after_mark/100) * gc->interval_ratio;
  if (((gc)->generational)) {
    gc->majorgc_old_threshold = gc->live_after_mark/100 * 120;
    gc->full = 0;
  }
  ;
}
extern void
mrb_garbage_collect(mrb_state *mrb)
{
