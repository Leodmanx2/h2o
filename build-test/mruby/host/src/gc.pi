static size_t
incremental_sweep_phase(mrb_state *mrb, mrb_gc *gc, size_t limit)
{
  mrb_heap_page *page = gc->sweeps;
  size_t tried_sweep = 0;
  while (page && (tried_sweep < limit)) {
    RVALUE *p = ((RVALUE *)page->objects);
    RVALUE *e = p + 1024;
    size_t freed = 0;
    mrb_bool dead_slot = 1;
    mrb_bool full = (page->freelist == ((void *)0));
    if ((((gc)->generational) && !(gc)->full) && page->old) {
      p = e;
      dead_slot = 0;
    }
    while (p<e) {
      if ((((&p->as.basic)->color & ((gc)->current_white_part ^ (1 | (1 << 1))) & (1 | (1 << 1))) || (&p->as.basic)->tt == MRB_TT_FREE)) {
        if (p->as.basic.tt != MRB_TT_FREE) {
          obj_free(mrb, &p->as.basic, 0);
          if (p->as.basic.tt == MRB_TT_FREE) {
            p->as.free.next = page->freelist;
            page->freelist = (struct RBasic*)p;
            freed++;
          }
          else {
            dead_slot = 0;
          }
        }
      }
      else {
        if (!((gc)->generational))
          ((&p->as.basic)->color = (gc)->current_white_part);
        dead_slot = 0;
      }
      p++;
    }
    if (dead_slot && freed < 1024) {
      mrb_heap_page *next = page->next;
      unlink_heap_page(gc, page);
      unlink_free_heap_page(gc, page);
      mrb_free(mrb, page);
      page = next;
    }
    else {
      if (full && freed > 0) {
        link_free_heap_page(gc, page);
      }
      if (page->freelist == ((void *)0) && (((gc)->generational) && !(gc)->full))
        page->old = 1;
      else
        page->old = 0;
      page = page->next;
    }
    tried_sweep += 1024;
    gc->live -= freed;
    gc->live_after_mark -= freed;
  }
  gc->sweeps = page;
  return tried_sweep;
}
static size_t
incremental_gc(mrb_state *mrb, mrb_gc *gc, size_t limit)
{
