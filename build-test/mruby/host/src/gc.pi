}
extern void
mrb_field_write_barrier(mrb_state *mrb, struct RBasic *obj, struct RBasic *value)
{
  mrb_gc *gc = &mrb->gc;
  if (!((obj)->color == (1 << 2))) return;
  if (!((value)->color & (1 | (1 << 1)))) return;
  ((void)0);
  ((void)0);
