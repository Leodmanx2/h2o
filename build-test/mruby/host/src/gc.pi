static mrb_bool
heap_p(mrb_gc *gc, struct RBasic *object)
{
  mrb_heap_page* page;
  page = gc->heaps;
  while (page) {
    RVALUE *p;
    p = ((RVALUE *)page->objects);
    if (&p[0].as.basic <= object && object <= &p[1024 - 1].as.basic) {
      return 1;
