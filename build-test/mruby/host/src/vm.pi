enum {
  RBREAK_TAG_BREAK = 0, RBREAK_TAG_BREAK_UPPER = 1, RBREAK_TAG_BREAK_INTARGET = 2, RBREAK_TAG_RETURN_BLOCK = 3, RBREAK_TAG_RETURN = 4, RBREAK_TAG_RETURN_TOPLEVEL = 5, RBREAK_TAG_JUMP = 6, RBREAK_TAG_STOP = 7,
};
static inline uint32_t
mrb_break_tag_get(struct RBreak *brk)
{
  return (brk->flags >> 8) & (~(~0U << 3));
}
static inline void
mrb_break_tag_set(struct RBreak *brk, uint32_t tag)
{
  brk->flags &= ~((~(~0U << 3)) << 8);
  brk->flags |= (tag & (~(~0U << 3))) << 8;
}
