void
mrb_mruby_socket_gem_final(mrb_state* mrb)
{
  mrb_value ai;
  ai = mrb_mod_cv_get(mrb, mrb_class_get_id(mrb, <@! "Addrinfo" !@>), <@! "_lastai" !@>);
  if ((!((ai).w & 0x07 || (ai).w == MRB_Qnil) && mrb_val_union(ai).bp->tt == MRB_TT_CPTR)) {
    freeaddrinfo((struct addrinfo*)mrb_val_union(ai).vp->p);
  }
}
